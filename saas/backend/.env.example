DATABASE_URL=postgresql+psycopg2://fir:fir@localhost:5432/fir_saas
JWT_SECRET=replace-with-long-random-string
ADMIN_JWT_SECRET=replace-with-different-long-random-string
# Production (Railway, etc.): use true so invoice + FIR monthly caps enforce subscription rules.
# Local quick-testing without limits: set false (FIR workspace /trial still gated separately).
ENABLE_SUBSCRIPTION=true
# Desktop product licensing (QR_CODE / ASN_*). Default false — keep off until Phases 2–7A are reviewed.
ENABLE_DESKTOP_LICENSING=false
# Required before minting/revealing license keys: a valid Fernet key (NOT a passphrase).
# Generate locally (do not commit the value): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LICENSE_KEY_ENCRYPTION_SECRET=
# Ed25519 private signing key for entitlements (Phase 7). Server-side only — never commit production keys.
# LICENSE_SIGNING_PRIVATE_KEY=
# Offline entitlement window (days). Revoked/suspended offline PCs may work until naf.
# LICENSE_MAX_OFFLINE_DAYS=14
# Baseline machine API rate limit per minute (in-process; not distributed across workers).
# LICENSE_API_RATE_LIMIT_PER_MINUTE=30
# Phase 6 private installer storage: reuse AWS_* + S3_BUCKET_NAME (private objects). Do NOT use PUBLIC_S3_BASE_URL for installers.
# INSTALLER_STORAGE_BACKEND=s3
# INSTALLER_S3_PREFIX=desktop-installers
# INSTALLER_S3_BUCKET=
# INSTALLER_MAX_UPLOAD_BYTES=536870912
# INSTALLER_DOWNLOAD_TOKEN_TTL_SECONDS=120
BOOTSTRAP_ADMIN_EMAIL=chandanregins1@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=123456
UPI_ID=chandanregins1@okaxis
WHATSAPP_NUMBER=+91-7892007580
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: list your SPA origin(s). The API also auto-adds the www ⟷ apex pair for two-part domains (e.g. theaiqualisys.com and www.theaiqualisys.com) when you include one of them here or in PUBLIC_APP_URL.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Native PostgreSQL on Windows (no Docker): docs/POSTGRES_WINDOWS.md
# Create DB: run ../database/init_fir_saas_postgres.sql (from repo: saas/database/...) as superuser postgres
LEGACY_SQLITE_PATH=

# Optional: direct browser → S3 uploads for Global FIR settings (logo, signatures, font).
# When all are set, /api/app/settings uses presigned PUT URLs and stores only object keys in Postgres.
# Do not commit real keys; configure in Railway/hosting secrets.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=your-bucket
# FIR admin: Expected QTY median only counts rows with invoice_date >= this (YYYY-MM-DD). Legacy rows often have qty 0 before analytics shipped.
# Use 2026-04-29 if reliable qty started then; or 2026-05-01 as in app default.
FIR_INTELLIGENCE_QTY_RELIABLE_SINCE=2026-05-01

