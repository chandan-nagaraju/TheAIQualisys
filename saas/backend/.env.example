# Used for password-reset links and, in production, appended to CORS allow list.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Native PostgreSQL on Windows (no Docker): docs/POSTGRES_WINDOWS.md
