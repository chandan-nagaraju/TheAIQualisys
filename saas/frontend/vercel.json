{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://theaiqualisys-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://theaiqualisys-api-production.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/subscription/:path*",
      "destination": "https://theaiqualisys-api-production.up.railway.app/api/subscription/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://theaiqualisys-api-production.up.railway.app/api/admin/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
